# supabase (server-side only - never exposed to the browser)
# get these frm supabase dashboard > settings > api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# optional: secret mixed into daily-rotating visitor hash fr /api/events (any long random string)
# falls back to SUPABASE_PUBLISHABLE_KEY whn unset - set it if you ever rotate/expose that key
EVENTS_SALT=
